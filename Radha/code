def decompose(s, period):
    if HAS_SM:
        return seasonal_decompose(s, model="additive", period=period, extrapolate_trend="freq")
    class _D: pass
    d = _D()
    d.trend = s.rolling(period, center=True, min_periods=period // 2).mean()
    seas = (s - d.trend).groupby(np.arange(len(s)) % period).transform("mean")
    d.seasonal = seas - seas.mean(); d.resid = s - d.trend - d.seasonal; d.observed = s
    return d

# ------------------------------------------------------------------------------------
# ADF stationarity test
# ------------------------------------------------------------------------------------
def _adf_tau_numpy(y):
    """Augmented Dickey-Fuller t-statistic (constant, lags chosen by AIC). Only used if statsmodels is missing."""
    y = np.asarray(y, float); n = len(y); dy = np.diff(y)
    maxlag = int(np.ceil(12 * (n / 100) ** 0.25)); best = None
    for k in range(maxlag + 1):
        Y = dy[maxlag:]
        X = [np.ones(len(Y)), y[maxlag:n - 1]] + [dy[maxlag - j:n - 1 - j] for j in range(1, k + 1)]
        X = np.column_stack(X)
        beta, *_ = np.linalg.lstsq(X, Y, rcond=None)
        res = Y - X @ beta; T = len(Y); rss = (res ** 2).sum()
        aic = T * np.log(rss / T + 1e-12) + 2 * X.shape[1]
        if best is None or aic < best[0]:
            cov = rss / (T - X.shape[1]) * np.linalg.pinv(X.T @ X)
            best = (aic, beta[1] / np.sqrt(cov[1, 1]))
    return best[1]

def adf_stationary(s):
    """returns (is_stationary, text).  statsmodels: p-value <= 0.05 ; fallback: tau < -2.90 (5% critical value)"""
    s = s.dropna()
    if HAS_SM:
        p = adfuller(s, autolag="AIC")[1]
        return p <= ADF_ALPHA, f"p = {p:.4f}", p
    tau = _adf_tau_numpy(s.values)
    return tau < -2.90, f"tau = {tau:.2f} (approx.; 5% crit. -2.90)", np.nan


# FEATURE ENGINEERING (weekly; recursive-safe: past sales, calendar, known event/payday calendar)
# ------------------------------------------------------------------------------------
DIFF = [False]     # True while a NON-STATIONARY product is being modelled (1st difference)

def fourier(index, K=3):
    t = np.asarray(index.dayofyear) / 365.25
    cols = {}
    for k in range(1, K + 1):
        cols[f"sin{k}"] = np.sin(2 * np.pi * k * t); cols[f"cos{k}"] = np.cos(2 * np.pi * k * t)
    return pd.DataFrame(cols, index=index)

def sarimax_exog(index):
    ex = fourier(index, 3)
    ex["ev_festival"] = [_ex(d)["ev_festival"] for d in index]
    ex["ev_payday_days"] = [_ex(d)["ev_payday_days"] for d in index]
    return ex.astype(float)

def _lags_for(n):
    L = [1, 2, 3, 4, 8]
    if n >= 60:  L.append(13)
    if n >= 100: L.append(26)
    if n >= 130: L.append(52)
    return L

def _feat(hist, date, L):
    h = np.asarray(hist, float)
    f = {f"lag{l}": h[-l] for l in L}
    f["roll4"], f["roll8"], f["roll13"] = h[-4:].mean(), h[-8:].mean(), h[-13:].mean()
    f["std4"], f["std13"] = h[-4:].std(), h[-13:].std()
    f["max8"] = h[-8:].max()
    k = np.arange(min(26, len(h))); w = 0.7 ** k
    f["ewm"] = (h[-1 - k] * w).sum() / w.sum()
    f["momentum"] = h[-1] - h[-4:].mean()
    f["nz_share8"] = (h[-8:] != 0).mean()
    nz = np.nonzero(h)[0]
    f["wks_since_sale"] = min(len(h) - 1 - nz[-1], 26) if len(nz) else 26
    doy = date.dayofyear / 365.25
    f["sin1"], f["cos1"] = np.sin(2 * np.pi * doy), np.cos(2 * np.pi * doy)
    f["sin2"], f["cos2"] = np.sin(4 * np.pi * doy), np.cos(4 * np.pi * doy)
    f["month"] = date.month
    for c, v in _ex(date).items(): f[c] = v
    return f

IMP = {}

def _importance(model):
    m = model.steps[-1][1] if hasattr(model, "steps") else model
    if hasattr(m, "feature_importances_"): return np.asarray(m.feature_importances_, float)
    if hasattr(m, "coef_"): return np.abs(np.asarray(m.coef_, float))
    return None

def _recursive(factory, name, tr, fi):
    """Feature-based model. Features always come from the sales LEVEL history.
       Stationary product      : target = sales level
       Non-stationary (DIFF)   : target = week-on-week change y_t - y_(t-1); forecast level = last level + change."""
    L = _lags_for(len(tr)); start = max(max(L), 13)
    v = tr.values; X, y = [], []
    for i in range(start, len(tr)):
        row = _feat(v[:i], tr.index[i], L); X.append(list(row.values()))
        y.append(v[i] - v[i - 1] if DIFF[0] else v[i])
    names = list(row.keys())
    model = factory().fit(np.array(X), np.array(y))
    imp = _importance(model)
    if imp is not None: IMP[name] = pd.Series(imp, index=names).sort_values(ascending=False)
    hist, out = list(v), []
    for d in fi:
        p = float(model.predict(np.array([list(_feat(hist, d, L).values())]))[0])
        lvl = max(hist[-1] + p, 0.0) if DIFF[0] else max(p, 0.0)
        out.append(lvl); hist.append(lvl)
    return np.array(out)


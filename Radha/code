def run_product(pid, pname):
    print("\n" + "=" * 100 + f"\n{pid}  |  {pname}\n" + "=" * 100)
    df = df_all[df_all["product_id"] == pid]
    print(f"Rows: {len(df)} | active days: {df['date'].nunique()} | refund rows: {(df['sales'] < 0).sum()}")

    first = df["date"].min()
    daily = df.groupby("date")["sales"].sum().sort_index().reindex(
        pd.date_range(first, LAST_DATE, freq="D"), fill_value=0.0)       # no row = no sale = 0
    daily.index.name = "date"
    print(f"Daily series {first.date()} -> {LAST_DATE.date()}: {len(daily)} days, "
          f"{(daily == 0).mean() * 100:.0f}% zero-sales days")

    sel = daily != 0
    q1, q3 = daily[sel].quantile([.25, .75]); iqr = q3 - q1
    lo, hi = q1 - 3 * iqr, q3 + 3 * iqr
    n_out = int(((daily < lo) | (daily > hi))[sel].sum())
    if CAP_OUTLIERS and n_out / sel.sum() <= 0.05:
        daily = daily.where(~sel, daily.clip(lower=lo, upper=hi))
        print(f"Extreme outliers capped (3*IQR): {n_out}")
    else:
        print(f"3*IQR rule would cap {n_out} of {sel.sum()} selling days (lumpy product) -> capping skipped")

    weekly = daily.resample("W-SUN").agg(["sum", "count"])
    weekly = (weekly[weekly["count"] == 7]["sum"] / SCALE).rename("sales")
    weekly.index.freq = "W-SUN"
    monthly = daily.resample("MS").sum() / SCALE
    print(f"Weekly series: {len(weekly)} weeks ({weekly.index[0].date()} -> {weekly.index[-1].date()})")

    # ---- training window: only weeks BEFORE the forecast start (June 2025 onwards is what we forecast) ----
    weekly_full = weekly.copy()                       # everything in the data (used for plots / June comparison)
    weekly = weekly[weekly.index < FORECAST_START]
    weekly.index.freq = "W-SUN"
    print(f"Training weeks (before {FORECAST_START.date()}): {len(weekly)} "
          f"({weekly.index[0].date()} -> {weekly.index[-1].date()}); weeks after that are only used for comparison")

    # ---- stock-out / discontinuation check: trailing weeks with no (or only refund) sales ----
    stockout = False
    pos = np.nonzero(weekly.values > 0)[0]
    n_empty = len(weekly) - 1 - pos[-1] if len(pos) else 0
    if HANDLE_STOCKOUT and n_empty >= STOCKOUT_MIN_WEEKS:
        stockout = True
        weekly = weekly.iloc[:pos[-1] + 1]
        print(f"!! STOCK-OUT DETECTED: last {n_empty} weeks have no sales (last active week ends "
              f"{weekly.index[-1].date()}). These weeks are treated as missing, not as zero demand:\n"
              f"   models train on {weekly.index[0].date()} -> {weekly.index[-1].date()}, forecast covers the gap + Jul-Sep.")

    # ---- 1. initial time-series plots ----
    fig, ax = plt.subplots(3, 1, figsize=(14, 11))
    daily.div(SCALE).plot(ax=ax[0], color="steelblue", lw=.7)
    daily.div(SCALE).rolling(28).mean().plot(ax=ax[0], color="red", lw=1.5, label="28-day mean")
    ax[0].set_title(f"{pid} - Daily net sales ({UNIT})"); ax[0].legend()
    weekly_full.plot(ax=ax[1], color="steelblue", marker="o", ms=3, label="weekly")
    weekly_full.rolling(13).mean().plot(ax=ax[1], color="red", lw=2, label="13-week rolling mean")
    if stockout:
        ax[1].axvspan(weekly.index[-1], weekly_full.index[-1], color="gray", alpha=.25, label="no sales (stock-out?)")
    ax[1].set_title(f"{pid} - Weekly net sales ({UNIT})"); ax[1].legend()
    ax[2].bar(range(len(monthly)), monthly.values, color="steelblue")
    ax[2].set_xticks(range(len(monthly)))
    ax[2].set_xticklabels([d.strftime("%b-%y") for d in monthly.index], rotation=90)
    ax[2].set_title(f"{pid} - Monthly net sales ({UNIT})")
    save_show(fig)

    fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))
    m = monthly.to_frame("v"); m["year"] = m.index.year; m["month"] = m.index.month
    for yr, g in m.groupby("year"): ax[0].plot(g["month"], g["v"], marker="o", label=str(yr))
    ax[0].set_title(f"{pid} - Monthly sales by year (overlay)"); ax[0].set_xlabel("month"); ax[0].legend()
    dow = daily.groupby(daily.index.dayofweek).mean().reindex(range(7)) / SCALE
    ax[1].bar(DOW, dow.values, color="teal")
    ax[1].set_title(f"{pid} - Average sales by day of week ({UNIT})")
    save_show(fig)

    # ---- 2. decomposition ----
    per = SEASON if len(weekly) >= 2 * SEASON else 13
    dec = decompose(weekly, per)
    fig, ax = plt.subplots(4, 1, figsize=(13, 10), sharex=True)
    for a, (n, v, c) in zip(ax, [("Observed", weekly, "steelblue"), ("Trend", dec.trend, "red"),
                                 ("Seasonal", dec.seasonal, "green"), ("Residual", dec.resid, "gray")]):
        a.plot(v, color=c); a.set_ylabel(n)
    ax[0].set_title(f"{pid} - Weekly decomposition (additive, period = {per}"
                    f"{'' if per == SEASON else ' ; history < 2 years, so 52 not possible'})")
    save_show(fig)

    # ---- 3. stationarity: ADF on level -> difference if needed ----
    stat_lvl, txt_lvl, p_lvl = adf_stationary(weekly)
    stat_d1, txt_d1, p_d1 = adf_stationary(weekly.diff())
    DIFF[0] = bool(DIFFERENCE_NONSTATIONARY and not stat_lvl)
    print(f"ADF test on weekly level          : {txt_lvl} -> {'STATIONARY' if stat_lvl else 'NON-stationary'}")
    print(f"ADF test on 1st difference        : {txt_d1} -> {'stationary' if stat_d1 else 'non-stationary'}")
    print(f"==> models are fitted on the {'1st DIFFERENCE of weekly sales (forecasts added back to level)' if DIFF[0] else 'weekly sales LEVEL'}")
    all_adf.append(dict(product_id=pid, adf_level=txt_lvl, level_stationary=stat_lvl,
                        adf_diff1=txt_d1, series_used="1st difference" if DIFF[0] else "level"))
    fig, ax = plt.subplots(2, 1, figsize=(13, 6), sharex=True)
    ax[0].plot(weekly, color="steelblue"); ax[0].set_title(f"{pid} - weekly level (ADF {txt_lvl})")
    ax[1].plot(weekly.diff(), color="purple"); ax[1].axhline(0, color="k", lw=.5)
    ax[1].set_title(f"{pid} - 1st difference (ADF {txt_d1})")
    save_show(fig)

    # ---- 4. train / test ----
    h_test = min(H_TEST, max(4, len(weekly) // 4))
    train, test = weekly.iloc[:-h_test], weekly.iloc[-h_test:]
    print(f"Train: {len(train)} wks ({train.index[0].date()} -> {train.index[-1].date()}) | "
          f"Test: {len(test)} wks ({test.index[0].date()} -> {test.index[-1].date()})")
    fig, ax = plt.subplots(figsize=(13, 4))
    ax.plot(train, label="Train", color="steelblue"); ax.plot(test, label="Test", color="green")
    ax.axvline(test.index[0], ls="--", color="k"); ax.legend()
    ax.set_title(f"{pid} - Train / Test split (weekly, {UNIT})")
    save_show(fig)

    # ---- 5. evaluate all methods ----
    METHODS = build_methods()
    preds, rows = {}, []
    for name, fn in METHODS.items():
        try:
            p = naive_rolling(train, test) if name == "Naive" else fn(train, test.index)
            p = np.asarray(p, dtype=float)
            preds[name] = pd.Series(p, index=test.index)
            rows.append(dict(Model=name, **metrics(test.values, p)))
        except Exception as e:
            print(f"   ({name} skipped: {e})")
    res = pd.DataFrame(rows).sort_values("RMSE").reset_index(drop=True)
    res.insert(0, "Rank", res.index + 1)                  # Naive is ranked like every other method
    top = res.head(TOP_N); top_names = list(top["Model"])
    nv_rmse = res.loc[res["Model"] == "Naive", "RMSE"].iloc[0]

    # ---- 6. ONE GRAPH PER TOP-3 METHOD (Naive drawn on each) ----
    plot_list = list(res["Model"]) if PLOT_ALL_METHODS else top_names
    for n in plot_list:
        r = res[res["Model"] == n].iloc[0]
        fig, ax = plt.subplots(figsize=(13, 4.8))
        ax.plot(train.iloc[-40:], color="steelblue", label="Train (last 40 wks)")
        ax.plot(test, color="k", lw=2.5, label="Actual")
        if n != "Naive":
            ax.plot(preds["Naive"], color="gray", ls=":", lw=2, marker="s", ms=3,
                    label=f"Naive - prev. week (RMSE {nv_rmse:.2f})")
        ax.plot(preds[n], color="red", ls="--", lw=2, marker="o", ms=4,
                label=f"{n} (RMSE {r['RMSE']:.2f})" if n != "Naive" else f"Naive - prev. week (RMSE {r['RMSE']:.2f})")
        ax.axvline(test.index[0], ls=":", color="k")
        ax.set_title(f"{pid} - #{int(r['Rank'])} {n}{'' if n == 'Naive' else ' vs Naive'}: test-period forecast ({UNIT}/week)"
                     f"{'   [modelled on 1st difference]' if DIFF[0] and n != 'Naive' else ''}")
        ax.legend(loc="upper left")
        save_show(fig)

    # ---- 7. metrics table ----
    summary = top if "Naive" in top_names else pd.concat([top, res[res["Model"] == "Naive"]], ignore_index=True)
    print(f"\n>>> {pid}: TOP-{TOP_N} METHODS (Naive included as a method; tested: {len(res)}; ranked by RMSE; {UNIT}/week)")
    print(summary.round(2).to_string(index=False))
    s2 = summary.copy(); s2.insert(0, "product_id", pid); all_summary.append(s2)
    for n in top_names:
        if n in IMP:
            print(f"   {n}: most important features -> " +
                  ", ".join(f"{k} ({v:.2g})" for k, v in IMP[n].head(6).items()))

    # ---- 8. BEST METHOD -> June 2025 (test-period prediction) and Jul-Sep 2025 (refit on all data) ----
    best = top_names[0]
    print(f"\nBEST METHOD for {pid}: {best}")
    if best == "Naive":
        print("   (Naive = last observed week repeated; its test score used the ACTUAL previous week each time)")
    fut_idx = pd.date_range(weekly.index[-1] + pd.Timedelta(weeks=1),
                            FORECAST_END + pd.Timedelta(days=6), freq="W-SUN")
    fut = pd.Series(METHODS[best](weekly, fut_idx), index=fut_idx).clip(lower=0)

    fig, ax = plt.subplots(figsize=(14, 6))
    ax.plot(weekly_full.loc["2024-09-01":], color="k", lw=2, label="Actual weekly sales")
    ax.plot(preds[best], color="red", ls="--", marker="o", ms=4, lw=2,
            label=f"{best} - test-period prediction")
    ax.plot(pd.concat([preds[best].iloc[[-1]], fut]), color="darkorange", ls="--", marker="o", ms=4, lw=2.5,
            label=f"{best} - FORECAST June -> Sep 2025 (refit on weeks before 1-Jun)")
    ax.axvline(weekly.index[-1], color="gray", ls=":", label="forecast starts")
    if stockout:
        ax.axvspan(weekly.index[-1], weekly_full.index[-1], color="gray", alpha=.2, label="no sales recorded (stock-out?)")
    ax.axvspan(pd.Timestamp("2025-06-01"), pd.Timestamp("2025-06-30"), color="gold", alpha=.15, label="June 2025")
    ax.set_title(f"{pid} - Best method ({best}): June 2025 -> Sep 2025 ({UNIT} / week)")
    ax.set_ylabel(f"Sales ({UNIT} / week)"); ax.legend(loc="upper left")
    save_show(fig)

    # ---- monthly table: June -> September 2025 (all four months are forecast) ----
    fut_m = weekly_to_monthly(fut, FORECAST_START, FORECAST_END)
    actual = {}
    for d in fut_m.index:                              # actual only for months fully inside the data (June)
        if d + pd.offsets.MonthEnd(0) <= LAST_DATE:
            actual[d] = daily.loc[d:d + pd.offsets.MonthEnd(0)].sum() / SCALE
    tab = pd.DataFrame({"Forecast": fut_m, "Actual (not used in training)": pd.Series(actual)})
    tab["Error_%"] = np.where(tab["Actual (not used in training)"] > 0,
                              (tab["Forecast"] - tab["Actual (not used in training)"]) /
                              tab["Actual (not used in training)"] * 100, np.nan)
    tab.index = [d.strftime("%b-%Y") for d in tab.index]
    tab.loc["Total Jun-Sep 2025"] = [fut_m.sum(), np.nan, np.nan]
    print(f"\n{pid}: {best} - FORECAST June -> September 2025 ({UNIT})")
    print(tab.round(2).to_string())
    if actual:
        a_j = list(actual.values())[0]
        if a_j <= 0.1 * fut_m.iloc[0]:
            print("   NOTE: June actual is far below the forecast -> the product may have stocked out / been "
                  "discontinued after May. The forecast is expected demand if it is available.")

for pid, pname in TOP_5_PRODUCTS.items():
    run_product(pid, pname)


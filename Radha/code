# FORECASTING METHODS
# ------------------------------------------------------------------------------------
def m_naive(tr, fi):
    # previous week's value = this week's prediction. For FUTURE weeks (no actuals yet): last observed week, repeated.
    return np.repeat(tr.iloc[-1], len(fi))

def naive_rolling(tr, te):
    # on the TEST weeks each week is predicted by the ACTUAL previous week (week 1 <- last train week, week 2 <- week 1 ...)
    return pd.concat([tr.iloc[[-1]], te]).iloc[:-1].values

def m_sma(tr, fi, k=8):
    h = list(tr.values)
    for _ in fi: h.append(np.mean(h[-k:]))
    return np.array(h[-len(fi):])

def m_wma(tr, fi, k=8):
    w = np.arange(1, k + 1); w = w / w.sum()
    h = list(tr.values)
    for _ in fi: h.append(np.dot(h[-k:], w))
    return np.array(h[-len(fi):])

def m_seasonal_idx(tr, fi):
    if DIFF[0]:
        raise ValueError("ratio-to-moving-average indices do not apply to a differenced series")
    if len(tr) < 2 * SEASON:
        raise ValueError("needs >= 2 years of weekly history")
    cma = tr.rolling(SEASON, center=True).mean().rolling(2).mean().shift(-1)
    ratio = (tr / cma).replace([np.inf, -np.inf], np.nan).dropna()
    wk = ratio.index.isocalendar().week.clip(upper=52).values
    idx = ratio.groupby(wk).mean().reindex(range(1, 53)).interpolate(limit_direction="both")
    idx = idx.rolling(3, center=True, min_periods=1).mean(); idx = idx / idx.mean()
    des = tr / idx.reindex(tr.index.isocalendar().week.clip(upper=52).values).values
    return des.iloc[-13:].mean() * idx.reindex(fi.isocalendar().week.clip(upper=52).values).values

def m_lgbm(tr, fi):  return _recursive(_gbm, GBM_NAME, tr, fi)
def m_ridge(tr, fi): return _recursive(lambda: make_pipeline(StandardScaler(), RidgeCV(alphas=[1, 3, 10, 30, 100, 300])),
                                       "Ridge (FE + events)", tr, fi)

def on_series(fn):
    """Run a series-based method on the weekly level, or - for NON-stationary products - on the 1st difference,
       then add the forecast changes back up to a sales level (cumulative sum from the last observed week)."""
    def g(tr, fi):
        if not DIFF[0]:
            return fn(tr, fi)
        d = np.asarray(fn(tr.diff().dropna(), fi), float)
        return np.maximum(tr.iloc[-1] + np.cumsum(d), 0.0)
    return g

if HAS_SM:
    def m_ses(tr, fi):
        return SimpleExpSmoothing(tr, initialization_method="estimated").fit().forecast(len(fi)).values

    def m_holt_winters(tr, fi):
        if len(tr) >= 2 * SEASON:
            mdl = ExponentialSmoothing(tr, trend="add", damped_trend=True, seasonal="add",
                                       seasonal_periods=SEASON, initialization_method="heuristic")
        else:
            mdl = ExponentialSmoothing(tr, trend="add", damped_trend=True, initialization_method="estimated")
        return mdl.fit().forecast(len(fi)).values

    ORDERS = {}
    def _grid(tr, ps, qs):
        best, best_aic = None, np.inf
        for p in ps:
            for q in qs:
                if p == 0 and q == 0: continue
                try:
                    r = ARIMA(tr, order=(p, 0, q)).fit()          # d = 0: series is already stationary (or differenced)
                    if r.aic < best_aic: best, best_aic = (p, 0, q), r.aic
                except Exception:
                    pass
        return best or (1, 0, 1)

    def m_arima(tr, fi):
        o = _grid(tr, range(0, 4), range(0, 4)); ORDERS["ARIMA"] = o
        return ARIMA(tr, order=o).fit().forecast(len(fi)).values

    def m_sarimax(tr, fi):
        o = (1, 0, 1); ORDERS["SARIMAX"] = o
        r = SARIMAX(tr, exog=sarimax_exog(tr.index), order=o, enforce_stationarity=False,
                    enforce_invertibility=False).fit(disp=False)
        return r.forecast(len(fi), exog=sarimax_exog(fi)).values

def build_methods():
    M = {"Naive": m_naive, "Moving Average (8w)": on_series(m_sma), "Weighted MA (8w)": on_series(m_wma),
         "Seasonal Indices": m_seasonal_idx, GBM_NAME: m_lgbm, "Ridge (FE + events)": m_ridge}
    if HAS_SM:
        M.update({"Exp. Smoothing (SES)": on_series(m_ses), "Holt-Winters (damped)": on_series(m_holt_winters),
                  "ARIMA(p,d,q)": on_series(m_arima), "SARIMAX (Fourier + events)": on_series(m_sarimax)})
    return M

def metrics(y, p):
    y, p = np.asarray(y, float), np.asarray(p, float)
    nz = y != 0
    wape = np.abs(y - p).sum() / np.abs(y).sum() * 100 if np.abs(y).sum() else np.nan
    acc = max(0.0, 100.0 - wape) if not np.isnan(wape) else np.nan
    return dict(Accuracy_pct=acc, RMSE=np.sqrt(mean_squared_error(y, p)), MAE=mean_absolute_error(y, p),
                WAPE_pct=wape,
                MAPE_pct=np.mean(np.abs((y[nz] - p[nz]) / y[nz])) * 100 if nz.any() else np.nan,
                Bias=np.mean(p - y))

def weekly_to_monthly(s, start, end):
    """spread each Mon-Sun week evenly over its 7 days, keep days start..end, sum per calendar month"""
    d = s.reindex(pd.date_range(s.index[0] - pd.Timedelta(days=6), s.index[-1])).bfill() / 7
    return d.loc[start:end].resample("MS").sum()

